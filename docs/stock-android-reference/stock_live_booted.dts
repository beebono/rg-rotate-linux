	audiocp_boot {
		bootvector = <0x0b 0x140 0xffffffff>;
		sysreset = <0x02 0xb0 0x200>;
		sysshutdown = <0x02 0x60 0x2000000>;
		deepsleep = <0x02 0xcc 0x80000>;
		bootaddress_sel = <0x0b 0x144 0x01>;
		sleepstatus = <0x02 0xd4 0xf000>;
		reset_sel = <0x02 0x7a4 0xff>;
		coreshutdown = <0x02 0x5c 0x1000000>;
		compatible = "unisoc,sharkl5-audcp-boot\0unisoc,sharkl5pro-audcp-boot";
		corestatus = <0x02 0x10c 0xff>;
		bootprotect = <0x0b 0x78 0xffff>;
		sysstatus = <0x02 0xb8 0xff000000>;
		corereset = <0x02 0xb0 0x400>;
	};

	apipe-cmd-in {
		compatible = "unisoc,apipe";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@700 {
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0xaa>;
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			dynamic-power-coefficient = <0x1f5>;
			cpufreq-data-v1 = <0xab>;
			reg = <0x00 0x700>;
			enable-method = "psci";
			phandle = <0x9f>;
		};

		cpu@400 {
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x400>;
			enable-method = "psci";
			phandle = <0x99>;
		};

		cpu@100 {
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x100>;
			enable-method = "psci";
			phandle = <0x93>;
		};

		cpu@0 {
			sugov_slack_timer;
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x00>;
			enable-method = "psci";
			phandle = <0x91>;
			#cooling-cells = <0x02>;
		};

		cpu@500 {
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x500>;
			enable-method = "psci";
			phandle = <0x9b>;
		};

		cpu@200 {
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x200>;
			enable-method = "psci";
			phandle = <0x95>;
		};

		cpu-map {

			cluster1 {

				core0 {
					cpu = <0x9d>;
				};

				core1 {
					cpu = <0x9f>;
				};
			};

			cluster0 {

				core0 {
					cpu = <0x91>;
				};

				core2 {
					cpu = <0x95>;
				};

				core4 {
					cpu = <0x99>;
				};

				core1 {
					cpu = <0x93>;
				};

				core3 {
					cpu = <0x97>;
				};

				core5 {
					cpu = <0x9b>;
				};
			};
		};

		cpu@600 {
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0xaa>;
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			dynamic-power-coefficient = <0x1f5>;
			cpufreq-data-v1 = <0xab>;
			reg = <0x00 0x600>;
			enable-method = "psci";
			phandle = <0x9d>;
			#cooling-cells = <0x02>;
		};

		cpu@300 {
			capacity-dmips-mhz = <0x220>;
			cpu-idle-states = <0xa8>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xa9>;
			reg = <0x00 0x300>;
			enable-method = "psci";
			phandle = <0x97>;
		};
	};

	sprd_backlight {
		pwm-names = "backlight";
		default-brightness-level = <0xfa>;
